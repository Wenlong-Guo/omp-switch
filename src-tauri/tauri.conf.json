{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omp-switch",
  "version": "0.1.1",
  "identifier": "com.omp-switch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "omp-switch",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "oh-my-pi 配置管理器",
    "longDescription": "omp-switch 是 oh-my-pi 的桌面配置管理器，支持 Provider 管理、一键切换和 WebDAV 多端同步。"
  }
}
